// El mismo identificador con el que se registro la matera.
#define DISPOSITIVO_ID     "ESP32-A3F2"

// Lo imprime utilidades/preparar_demo.py al registrar la matera.
#define TOKEN_DISPOSITIVO  "pega_aqui_el_token"

// Cada cuanto se envia una lectura.
#define INTERVALO_MS       5000
